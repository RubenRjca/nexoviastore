# Copia como .env.local para pruebas locales y carga las mismas variables en Vercel > Settings > Environment Variables.
# NUNCA subas llaves reales a GitHub ni las pegues en el HTML.

# OBLIGATORIA. test_sk_... para sandbox; live_sk_... para vender de verdad.
DROPANAS_API_KEY=test_sk_PEGA_AQUI_TU_LLAVE_DE_PRUEBA

# OPCIONAL. Tasa Bs por 1 USD para mostrar precios en bolívares. Si no la defines, se deduce de DroPanas
# (precio sugerido en Bs / USD de tu primer producto configurado). Si ninguna funciona, la tienda muestra solo USD.
# TASA_BS=

# OPCIONAL. Activa el asistente de ventas con IA (api/asistente.js). Sin esta llave el widget usa respuestas fijas y WhatsApp.
# ANTHROPIC_API_KEY=
# ASISTENTE_MODEL=claude-haiku-5-5

# RECOMENDADO al empezar a vender: retiene también los pedidos Contra Entrega hasta que los apruebes en DroPanas
# (así confirmas por WhatsApp antes de enviar y evitas pedidos falsos). 1 = activado.
# COD_REQUIERE_APROBACION=1

# OPCIONAL. Secreto del webhook de DroPanas (Integraciones → Webhooks; se muestra una sola vez). Activa POST /api/webhook.
# Sin esta variable el endpoint responde 503 y no acepta nada. URL a registrar en DroPanas: https://TU-DOMINIO/api/webhook
# DROPANAS_WEBHOOK_SECRET=

# Número de WhatsApp de la tienda para la confirmación de pedidos (internacional, sin + ni espacios). Vacío = 584245474761
WHATSAPP_TIENDA=

# --- Cuentas con Google (ver docs/CUENTAS.md) ---
GOOGLE_CLIENT_ID=
SESSION_SECRET=            # mínimo 32 caracteres aleatorios
REQUIERE_CUENTA=0          # 1 = exigir cuenta para comprar (actívalo solo tras probar el login)
MARGEN_MIN_USD=5           # alerta en logs si la ganancia estimada baja de este valor
COMISION_USD=0.5           # comisión estimada por pedido para el cálculo de margen
